<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">#0D1017</item>
        <item name="android:statusBarColor">#0D1017</item>
        <item name="android:navigationBarColor">#0D1017</item>
        <item name="android:textColor">#F3F4F6</item>
    </style>

    <style name="RemoteKey">
        <item name="android:background">@drawable/bg_key</item>
        <item name="android:textColor">#F3F4F6</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="AppChip">
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:textColor">#E5E7EB</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:minHeight">40dp</item>
    </style>
</resources>
